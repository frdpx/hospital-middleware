# ---- Copy to .env and adjust. Never commit .env ----

# HTTP server
APP_ENV=development
APP_PORT=8080
# Host port nginx publishes; all traffic should go through nginx, not the API
NGINX_PORT=8080
# Comma-separated; used only for logging/context, not auth
APP_LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital_dev_password
POSTGRES_DB=hospital_middleware
POSTGRES_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Run embedded SQL migrations on API startup (see docs/structure.md)
DB_AUTO_MIGRATE=true

# JWT — MUST be overridden in any non-local environment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=hospital-middleware
JWT_TTL=1h

# Outbound HIS calls
HIS_TIMEOUT=5s
# Global override of every hospital's HIS base URL. Empty => use each
# hospital's own hospitals.his_base_url, which points at the real (and from a
# dev machine, unreachable) https://hospital-a.api.co.th.
#
# For the docker compose `dev` profile, which runs the bundled mock HIS:
#   HIS_BASE_URL_OVERRIDE=http://mockhis:9090
# When running the API on the host with `go run ./cmd/mockhis`:
#   HIS_BASE_URL_OVERRIDE=http://localhost:9090
HIS_BASE_URL_OVERRIDE=http://mockhis:9090
